# ─── Vite (client) ─────────────────────────────────────────────
# Copied into `.env.development` / `.env.production` (or set here).
# Vite loads `.env.[mode]` automatically; only `VITE_*` vars reach the browser.
# `PORT` is read by vite.config for `npm run dev` / `npm run preview`.

PORT=5000

# Development (`npm run dev`):
#   VITE_API_BASE_URL=http://localhost:5001
#
# Production (`npm run build` / Docker image build):
#   VITE_API_BASE_URL=https://api.example.com
#   Leave empty to keep in-app mock auth/repositories.

VITE_API_BASE_URL=http://localhost:5001

# ─── Docker Compose (host / container) ─────────────────────────
# Read from `.env` by `docker compose` (not by Vite).

# Host port for the dashboard container (`docker compose up`).
APP_PORT=5000

# PostgreSQL started by docker compose.
POSTGRES_USER=smart
POSTGRES_PASSWORD=smart
POSTGRES_DB=smart
POSTGRES_PORT=5432
# From the host: postgresql://smart:smart@localhost:5432/smart
# From another compose service: postgresql://smart:smart@db:5432/smart

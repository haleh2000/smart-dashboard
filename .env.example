# Base URL of the SMART backend (see api.yml once it is added to the repo root).
# Passed into the image as a build arg by docker compose.
VITE_API_BASE_URL=http://localhost:8080

# Host port for the dashboard container (`docker compose up`).
# Kept off 8080 so it does not collide with VITE_API_BASE_URL.
APP_PORT=3000

# PostgreSQL started by docker compose.
POSTGRES_USER=smart
POSTGRES_PASSWORD=smart
POSTGRES_DB=smart
POSTGRES_PORT=5432
# From the host: postgresql://smart:smart@localhost:5432/smart
# From another compose service: postgresql://smart:smart@db:5432/smart
